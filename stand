-- Mwah Variables
local mwaing = false
local mwahTarget = nil
local mwahConnection = nil
local previousYPosition = nil
local mwahTrack = nil -- Store the animation track to stop it later

-- Function to play the mwah animation (2x speed and looping)
local function playMwahAnimation()
    stopAllAnimations()
    local animator = humanoid:FindFirstChildOfClass("Animator")
    if not animator then
        animator = Instance.new("Animator")
        animator.Parent = humanoid
    end

    -- Load the animation
    local anim = Instance.new("Animation")
    anim.AnimationId = "rbxassetid://10714061912"

    mwahTrack = animator:LoadAnimation(anim)
    mwahTrack.Priority = Enum.AnimationPriority.Action -- Ensure it overrides other animations
    mwahTrack.Looped = true -- Loop the animation

    -- Play animation, skipping first 0.8s, then play at 2x speed
    mwahTrack:Play()
    mwahTrack.TimePosition = 0.8
    task.wait(0.05)
    mwahTrack:AdjustSpeed(2) -- 2x speed
end

-- Function to start mwaing a target
local function startMwah(target)
    if not target or not target.Character or not target.Character:FindFirstChild("HumanoidRootPart") then
        chatChannel:SendAsync("Target not found or invalid.")
        return
    end

    mwaing = true
    mwahTarget = target

    -- Disable floating and following
    stopFloating()
    stopFollowingHost()
    destroyFloating()

    -- Save the current Y position
    previousYPosition = humanoidRootPart.Position.Y

    -- Move in front of the target and stay locked onto their front
    mwahConnection = game:GetService("RunService").Heartbeat:Connect(function()
        if not mwaing or not mwahTarget or not mwahTarget.Character or not mwahTarget.Character:FindFirstChild("HumanoidRootPart") then
            stopMwah()
            return
        end

        local targetHRP = mwahTarget.Character.HumanoidRootPart
        local frontPosition = targetHRP.Position + targetHRP.CFrame.LookVector * 2 -- Stay in front

        -- Explicitly set the Y position to target's Y to prevent floating
        local newPosition = Vector3.new(frontPosition.X, targetHRP.Position.Y, frontPosition.Z)
        humanoidRootPart.CFrame = CFrame.new(newPosition, Vector3.new(targetHRP.Position.X, targetHRP.Position.Y, targetHRP.Position.Z))
    end)

    -- Play the adjusted mwah animation
    playMwahAnimation()
end

-- Function to stop mwaing and return to platform WITHOUT floating
local function stopMwah()
    if mwahConnection then
        mwahConnection:Disconnect()
        mwahConnection = nil
    end

    mwaing = false
    mwahTarget = nil

    -- Stop the mwah animation
    if mwahTrack then
        mwahTrack:Stop()
