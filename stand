-- Variables for spam functionality
local spamming = false
local spamMessage = ""
local spamThread = nil

-- Function to start spamming a message
local function startSpam(message)
    if spamming then return end -- Prevent multiple spam loops

    spamming = true
    spamMessage = message

    -- Start the spam loop in a separate thread
    spamThread = task.spawn(function()
        while spamming do
            chatChannel:SendAsync(spamMessage)
            task.wait(1) -- Wait 1 second before sending the next message
        end
    end)
end

-- Function to stop spamming
local function stopSpam()
    if spamThread then
        task.cancel(spamThread) -- Stop the spam thread
        spamThread = nil
    end

    spamming = false
    spamMessage = ""
end

