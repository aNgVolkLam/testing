-- Bang Variables
local banging = false
local bangTarget = nil
local bangConnection = nil
local bangSpeed = 35 -- EXTREMELY fast movement speed
local bangDistance = 2 -- Distance moved back and forth

-- Function to play the bang animation
local function playBangAnimation()
    stopAllAnimations()
    local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", humanoid)
    local animation = Instance.new("Animation")
    animation.AnimationId = "rbxassetid://10714377090"

    local track = animator:LoadAnimation(animation)
    track.Priority = Enum.AnimationPriority.Action
    track.Looped = false
    track:Play()
    track.TimePosition = 1.5
    task.wait(0.1)
    track:AdjustSpeed(0) -- Freeze animation in place
end

-- Function to start banging a target
local function startBanging(target)
    if not target or not target.Character or not target.Character:FindFirstChild("HumanoidRootPart") then
        chatChannel:SendAsync("Target not found or invalid.")
        return
    end

    banging = true
    bangTarget = target
    stopFollowingHost()
    
    -- Keep floating enabled
    startFloating()

    bangConnection = game:GetService("RunService").Heartbeat:Connect(function()
        if not banging or not bangTarget or not bangTarget.Character or not bangTarget.Character:FindFirstChild("HumanoidRootPart") then
            stopBanging()
            return
        end

        local targetHRP = bangTarget.Character.HumanoidRootPart
        local lookVector = targetHRP.CFrame.LookVector

        -- Move back and forth **extremely fast**
        local bangOffset = math.sin(tick() * bangSpeed) * bangDistance
        local offset = lookVector * (-2 + bangOffset) -- Lock to back while shifting position rapidly

        -- Apply the movement and face the target
        humanoidRootPart.CFrame = CFrame.new(targetHRP.Position + offset, targetHRP.Position)
    end)

    -- Play bang animation
    playBangAnimation()
end

-- Function to stop banging
local function stopBanging()
    if bangConnection then
        bangConnection:Disconnect()
        bangConnection = nil
    end

    banging = false
    bangTarget = nil
    stopAllAnimations()

    -- Ensure floating remains active after stopping
    teleportToPlatform()
    startFloating()
    ensureAnimationPersists()
end

