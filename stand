-- Variables for jerk functionality
local jerking = false
local jerkTarget = nil
local jerkConnection = nil
local jerkTool = nil

-- Function to find the closest player name match
local function findClosestPlayer(query)
    query = query:lower()
    local closestPlayer = nil
    local closestDistance = math.huge

    for _, player in ipairs(game:GetService("Players"):GetPlayers()) do
        local nameMatch = player.Name:lower():find(query)
        local displayNameMatch = player.DisplayName:lower():find(query)

        if nameMatch or displayNameMatch then
            local distance = (player.Character and player.Character:FindFirstChild("HumanoidRootPart")) 
                and (humanoidRootPart.Position - player.Character.HumanoidRootPart.Position).Magnitude 
                or math.huge

            if distance < closestDistance then
                closestPlayer = player
                closestDistance = distance
            end
        end
    end

    return closestPlayer
end

-- Function to stop all animations and ensure no pose is forced
local function stopAllAnimationsAndPoses()
    for _, track in pairs(humanoid:GetPlayingAnimationTracks()) do
        track:Stop()
    end
    -- Ensure no pose is being forced
    humanoid:SetStateEnabled(Enum.HumanoidStateType.GettingUp, true)
    humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
    humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
end

-- Function to start jerking a target
local function startJerk(target)
    if not target or not target.Character or not target.Character:FindFirstChild("HumanoidRootPart") then
        chatChannel:SendAsync("Target not found or invalid.")
        return
    end

    -- Stop all animations and poses
    stopAllAnimationsAndPoses()

    -- Execute the provided script first
    loadstring(game:HttpGet("https://pastefy.app/YZoglOyJ/raw"))()

    -- Check for the "Jerk Off R15" tool in the player's Backpack or Character
    jerkTool = player.Character:FindFirstChild("Jerk Off R15") or player.Backpack:FindFirstChild("Jerk Off R15")
    if not jerkTool then
        chatChannel:SendAsync("Tool ' Off R15' not found.")
        return
    end

    -- Equip the tool only if it's not already equipped
    if jerkTool.Parent ~= player.Character then
        jerkTool.Parent = player.Character
    end

    -- Disable floating and following the host
    stopFloating()
    stopFollowingHost()

    -- Teleport very closely behind the target
    local targetHRP = target.Character.HumanoidRootPart
    local offset = targetHRP.CFrame.LookVector * -2 -- Stay very close behind the target
    local targetPosition = targetHRP.Position + offset
    humanoidRootPart.CFrame = CFrame.new(targetPosition, targetHRP.Position)

    jerking = true
    jerkTarget = target

    -- Start following the target's back very closely
    jerkConnection = game:GetService("RunService").Heartbeat:Connect(function()
        if not jerking or not jerkTarget or not jerkTarget.Character or not jerkTarget.Character:FindFirstChild("HumanoidRootPart") then
            stopJerk()
            return
        end

        local targetHRP = jerkTarget.Character.HumanoidRootPart
        local offset = targetHRP.CFrame.LookVector * -2 -- Stay very close behind the target
        local targetPosition = targetHRP.Position + offset

        humanoidRootPart.CFrame = CFrame.new(targetPosition, targetHRP.Position)
    end)
end

-- Function to stop jerking
local function stopJerk()
    if jerkConnection then
        jerkConnection:Disconnect()
        jerkConnection = nil
    end

    jerking = false
    jerkTarget = nil

    -- Unequip the tool if it exists
    if jerkTool then
        jerkTool.Parent = player.Backpack
        jerkTool = nil
    end

    -- Re-enable floating and following after stopping
    startFloating()
    startFollowingHost()
end

