-- Variables for orbit functionality
local orbiting = false
local orbitTarget = nil
local orbitConnection = nil
local orbitSpeedMultiplier = 1 -- Default speed multiplier

-- Function to find the closest player name match
local function findClosestPlayer(query)
    query = query:lower()
    local closestPlayer = nil
    local closestDistance = math.huge

    for _, player in ipairs(game:GetService("Players"):GetPlayers()) do
        local nameMatch = player.Name:lower():find(query)
        local displayNameMatch = player.DisplayName:lower():find(query)

        if nameMatch or displayNameMatch then
            local distance = (player.Character and player.Character:FindFirstChild("HumanoidRootPart")) 
                and (humanoidRootPart.Position - player.Character.HumanoidRootPart.Position).Magnitude 
                or math.huge

            if distance < closestDistance then
                closestPlayer = player
                closestDistance = distance
            end
        end
    end

    return closestPlayer
end

-- Function to start orbiting around a target
local function startOrbit(target)
    if not target or not target.Character or not target.Character:FindFirstChild("HumanoidRootPart") then
        return
    end

    orbiting = true
    orbitTarget = target
    stopFollowingHost() -- Stop following the host while orbiting

    -- Ensure floating remains active during orbiting
    startFloating()

    orbitConnection = game:GetService("RunService").Heartbeat:Connect(function()
        if not orbiting or not orbitTarget or not orbitTarget.Character or not orbitTarget.Character:FindFirstChild("HumanoidRootPart") then
            stopOrbit()
            return
        end

        local targetHRP = orbitTarget.Character.HumanoidRootPart
        local offset = Vector3.new(math.sin(tick() * 2 * orbitSpeedMultiplier) * 5, 0, math.cos(tick() * 2 * orbitSpeedMultiplier) * 5)
        local targetPosition = Vector3.new(targetHRP.Position.X + offset.X, humanoidRootPart.Position.Y, targetHRP.Position.Z + offset.Z)

        humanoidRootPart.CFrame = CFrame.new(targetPosition, Vector3.new(targetHRP.Position.X, humanoidRootPart.Position.Y, targetHRP.Position.Z))
    end)
end

-- Function to stop orbiting and handle teleportation
local function stopOrbit()
    if orbitConnection then
        orbitConnection:Disconnect()
        orbitConnection = nil
    end

    orbiting = false
    orbitTarget = nil
    orbitSpeedMultiplier = 1 -- Reset speed multiplier

    stopFloating()

    -- Teleport to the stand (platform) first
    teleportToPlatform()

    -- Re-enable floating and following after teleporting to the stand
    startFloating()
    startFollowingHost()
end

-- Add orbit commands to the host's chat listener
